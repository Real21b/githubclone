    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "@mui/lab": "^5.0.0-alpha.140",
    "axios": "^1.5.0",
    "react-hook-form": "^7.45.0",
    "@tanstack/react-query": "^5.0.0",
    "zustand": "^4.4.0",
