# Production Environment Variables
NODE_ENV=production

# API URLs - Production
VITE_GRAPHQL_URL=https://api.githubclone.com/graphql
VITE_API_URL=https://api.githubclone.com
VITE_REALTIME_URL=https://realtime.githubclone.com
VITE_INTEGRATION_URL=https://integrations.githubclone.com

# Authentication
VITE_JWT_SECRET=your-production-jwt-secret-key

# App Configuration
VITE_APP_NAME=GitHub Clone
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=A modern GitHub clone built with Vite and React

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# External Services
VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
VITE_SENTRY_DSN=https://your-sentry-dsn

# Performance
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_CACHE_TTL=300

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_HSTS=true
