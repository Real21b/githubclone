# Frontend Environment Variables

# API URLs
VITE_GRAPHQL_URL=http://localhost:3002/graphql
VITE_API_URL=http://localhost:3000
VITE_REALTIME_URL=http://localhost:3011
VITE_INTEGRATION_URL=http://localhost:3012

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key

# App Configuration
VITE_APP_NAME=GitHub Clone
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=A modern GitHub clone built with Vite and React

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# External Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Development
VITE_DEV_MODE=true
VITE_MOCK_API=false