# GitHub Clone — ortam değişkenleri örneği
#
#   cp .env.example .env
#
# Şema ve doğrulama: packages/config/src/env.ts
# Eksik veya zayıf bir sır varsa uygulama AÇILMAZ — fallback değer yoktur.

# ─── Çalışma zamanı ───────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Portlar (GELISTIRME-REHBERI.md Faz 1.3) ──────────────────────────────────
WEB_PORT=3000
API_PORT=4000
GIT_SERVER_PORT=4001
REALTIME_PORT=4002

# ─── Veritabanı ───────────────────────────────────────────────────────────────
POSTGRES_USER=githubclone
POSTGRES_PASSWORD=githubclone
POSTGRES_DB=githubclone
DATABASE_URL=postgresql://githubclone:githubclone@localhost:5432/githubclone

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=   # yalnızca üretimde zorunlu

# ─── Sırlar ───────────────────────────────────────────────────────────────────
# Her biri en az 32 karakter ve BİRBİRİNDEN FARKLI olmalı.
# Üretmek için:  openssl rand -base64 48
#
# Aşağıdaki değerler yalnızca yerel geliştirme içindir. Üretimde bir sır
# yöneticisi kullanın (Vault / AWS Secrets Manager / Doppler) — bkz. Faz 13.
JWT_SECRET=dev-only-jwt-secret-lutfen-uretimde-degistirin-0001
REFRESH_SECRET=dev-only-refresh-secret-lutfen-uretimde-degistirin-02
SESSION_SECRET=dev-only-session-secret-lutfen-uretimde-degistirin-03

# ─── Git deposu ───────────────────────────────────────────────────────────────
GIT_STORAGE_PATH=./.data/repos

# ─── Nesne depolama (MinIO / S3) ──────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=githubclone
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─── Genel ────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Frontend (NEXT_PUBLIC_* tarayıcıya gönderilir — sır KOYMAYIN) ────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4002

# ─── Gözlemlenebilirlik ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
