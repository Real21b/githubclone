# 🚀 Unified Environment Variables for All Services
# Copy this to .env.development and .env.production

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=githubclone_user
DB_PASSWORD=githubclone_password
DB_NAME=githubclone
DATABASE_URL=postgresql://githubclone_user:githubclone_password@localhost:5432/githubclone

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# SERVICE PORTS (UNIFIED)
# ===========================================
AUTH_SERVICE_PORT=3001
CORE_SERVICE_PORT=3002
FILE_SERVICE_PORT=3003
EMAIL_SERVICE_PORT=3004
SMS_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
WORDPRESS_SERVICE_PORT=3007
WHATSAPP_SERVICE_PORT=3008
TELEGRAM_SERVICE_PORT=3009
AI_SERVICE_PORT=3010
REALTIME_SERVICE_PORT=3011
INTEGRATION_SERVICE_PORT=3012

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# Development (Vite)
VITE_GRAPHQL_URL=http://localhost:3002/graphql
VITE_API_URL=http://localhost:3002
VITE_AUTH_URL=http://localhost:3001
VITE_REALTIME_URL=http://localhost:3011
VITE_INTEGRATION_URL=http://localhost:3012

# Production (Next.js)
NEXT_PUBLIC_GRAPHQL_URL=https://api.githubclone.com/graphql
NEXT_PUBLIC_API_URL=https://api.githubclone.com
NEXT_PUBLIC_AUTH_URL=https://auth.githubclone.com
NEXT_PUBLIC_REALTIME_URL=https://realtime.githubclone.com
NEXT_PUBLIC_INTEGRATION_URL=https://integrations.githubclone.com

# ===========================================
# KAFKA CONFIGURATION
# ===========================================
KAFKA_BROKER_URL=localhost:9092
KAFKA_CLIENT_ID=githubclone-client
KAFKA_GROUP_ID=githubclone-group

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AI Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-ai-api-key

# WordPress Integration
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your-username
WORDPRESS_PASSWORD=your-password

# WhatsApp Integration
WHATSAPP_SESSION_PATH=/app/sessions
WHATSAPP_QR_CODE_PATH=/app/qr-codes

# Telegram Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin123
LOG_LEVEL=info
ENABLE_METRICS=true

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
CORS_ORIGIN=http://localhost:3000,https://githubclone.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENCRYPTION_KEY=your-32-character-encryption-key

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================
NODE_ENV=development
MAX_CONNECTIONS=200
CACHE_TTL=300
ENABLE_COMPRESSION=true
ENABLE_CACHING=true

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt,md

# ===========================================
# WEBSOCKET CONFIGURATION
# ===========================================
WS_HEARTBEAT_INTERVAL=25000
WS_HEARTBEAT_TIMEOUT=60000
WS_MAX_CONNECTIONS=1000
WS_CORS_ORIGIN=http://localhost:3000,https://githubclone.com
