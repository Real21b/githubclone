# Production Environment Variables
# Copy this file to .env.production and update the values

# Database
POSTGRES_USER=githubclone_user
POSTGRES_PASSWORD=your-super-secure-database-password
POSTGRES_DB=githubclone_prod
DATABASE_URL=postgresql://githubclone_user:your-super-secure-database-password@db:5432/githubclone_prod?schema=public

# JWT
JWT_SECRET=your-super-secure-jwt-secret-key-for-production

# Redis
REDIS_PASSWORD=your-super-secure-redis-password

# Frontend
NEXT_PUBLIC_API_URL=https://your-domain.com/graphql

# Grafana
GRAFANA_PASSWORD=your-super-secure-grafana-password

# SSL/TLS (if using HTTPS)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key
