# 🚀 Ultra-Optimized Multi-stage build
FROM node:18-alpine AS base

# Install only production dependencies
FROM base AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production --no-audit --no-fund && npm cache clean --force

# Build with optimizations
FROM base AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# Ultra-optimized production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=128 --optimize-for-size"

# Create non-root user with specific UID/GID for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 authuser

# Copy only essential files
COPY --from=builder /app/dist ./dist
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Set proper permissions
RUN chown -R authuser:nodejs /app
USER authuser

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

CMD ["node", "--max-old-space-size=128", "dist/main.js"]
